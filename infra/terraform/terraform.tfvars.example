# Copia este ficheiro para terraform.tfvars e ajusta os valores.
# NUNCA commites terraform.tfvars (já está no .gitignore).

allowed_ssh_cidrs = ["203.0.113.10/32"] # o teu IP público atual, com /32

domain_name = "" # deixa vazio para a PoC: usa automaticamente um hostname sslip.io (ver README)
acme_email  = "admin@hopin.pt" # obrigatório, mesmo com o hostname sslip.io automático

# Opcional: só necessário se ghcr.io/pedrobsm/danceschool-web for um package privado.
# Preenche via variável de ambiente em vez deste ficheiro:
#   export TF_VAR_ghcr_username=pedrobsm
#   export TF_VAR_ghcr_token=ghp_xxx   (PAT com scope read:packages)
